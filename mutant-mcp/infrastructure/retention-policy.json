      "managedBy": "applier",
      "protectedClass": "raw-genetic",
      "enforcement": "s3-lifecycle",
      "retentionDays": null,
      "status": "pending",
      "owner": "infrastructure/backend",
      "decisionRef": "P3",
      "enforceLogicalExpiry": false,
      "note": "Route B raw DNA files. No lifecycle observed; product retention commitment is open."
    },
    {
      "id": "ddb-user-genomics",
      "store": "UserGenomics",
      "kind": "dynamodb-table",
      "managedBy": "applier",
      "protectedClass": "genetic-derived",
