# Target existing Mutant report-generator Lambda alias (leave empty to use the mock client).
# The MCP Lambda invokes this function directly with the versioned internal MCP
# contract; it must be reachable via IAM (lambda:InvokeFunction).
MUTANT_SERVICE_LAMBDA_ARN=

# OAuth resource-server configuration (Mutant's Cognito user pool / hosted UI).
MUTANT_OAUTH_ISSUER=
# Optional: expected `aud` claim. Leave empty for Cognito access tokens with no resource server.
MUTANT_OAUTH_AUDIENCE=
# Predefined Cognito app client authorized for the ChatGPT redirect URI with PKCE (S256).
MUTANT_OAUTH_CLIENT_ID=
# OAuth scope required by the model-facing analysis tools. Leave empty to derive
# `<MUTANT_MCP_RESOURCE_URI>/analysis.read` from the resource server identifier,
# e.g. https://dev-api.mutantbiotech.com/mcp/analysis.read. Set explicitly to
# override when the issuer names the scope differently.
MUTANT_OAUTH_SCOPE=
# OAuth scope required by the DNA import tools (show_dna_import, get_snp_catalog,
# create_report). Leave empty to derive `<MUTANT_MCP_RESOURCE_URI>/dna.import`.
# Kept separate from MUTANT_OAUTH_SCOPE so a read-only grant can never submit DNA.
MUTANT_OAUTH_SCOPE_DNA_IMPORT=
# Canonical RFC 9728 resource identifier for this MCP server (used in
# protected-resource metadata and WWW-Authenticate challenges).
MUTANT_MCP_RESOURCE_URI=

# Comma-separated CORS origin allowlist for browser MCP clients.
MUTANT_CORS_ORIGINS=https://chatgpt.com,https://chat.openai.com

# User-facing URLs
MUTANT_UPGRADE_URL=https://mutantgenomics.com/cart
MUTANT_ONBOARDING_URL=https://mutantgenomics.com/onboarding

# Backend request deadline (ms), kept below the API Gateway/Lambda timeout.
MUTANT_REQUEST_TIMEOUT_MS=20000
# Hard cap on a serialized tool response (bytes).
MUTANT_MAX_RESPONSE_BYTES=512000
# Per-tool override for get_snp_catalog: the SNP catalog is application data for
# the DNA import component, not model context, so it is allowed a larger
# response than the default cap.
MUTANT_SNP_CATALOG_MAX_BYTES=2000000
# Hard cap on a serialized tool request (bytes), for create_report payloads.
# Defaults to 5 MiB, below the 6 MiB synchronous lambda:InvokeFunction limit.
MUTANT_MAX_REQUEST_BYTES=5242880

# Development only: accept dev-free / dev-paid bearer tokens instead of real OIDC.
MUTANT_DEV_MODE=false

# Logging
LOG_LEVEL=info

# HTTP server port (Lambda Web Adapter default)
PORT=8080
