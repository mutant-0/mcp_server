# Target existing Mutant REST Lambda alias (leave empty to use the mock client)
MUTANT_SERVICE_LAMBDA_ARN=

# OAuth resource-server configuration (Mutant's OIDC provider)
MUTANT_OAUTH_ISSUER=
MUTANT_OAUTH_AUDIENCE=

# User-facing URLs
MUTANT_UPGRADE_URL=https://mutantgenomics.com/upgrade
MUTANT_ONBOARDING_URL=https://mutantgenomics.com/onboarding

# Development only: accept dev-free / dev-paid bearer tokens instead of real OIDC
MUTANT_DEV_MODE=false

# Logging
LOG_LEVEL=info

# HTTP server port (Lambda Web Adapter default)
PORT=8080
