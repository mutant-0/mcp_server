{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The DNA import Apps SDK component (src/ui/dna-import) is a browser bundle
    // that ships with the Lambda artifact, so the project type-checks against DOM
    // and JSX once. The Lambda entry (src/handler.ts) never imports the component;
    // only its prebuilt HTML module is reachable from the server graph.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    // The browser adapters and compatibility exports are plain JavaScript.
    // The shared parser package supplies its own declaration file.
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["src", "tests", "scripts", "infrastructure", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "cdk.out", "infrastructure/dist"]
}
